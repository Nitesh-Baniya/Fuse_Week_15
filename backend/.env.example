# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=AI Assistant
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_API_V1_PREFIX=/api/v1
CORS_ORIGINS='["http://localhost:3000"]'

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/assistant
# Set to true to see SQL queries in logs (useful for debugging)
DATABASE_ECHO=false

# ============================================
# REDIS AND RATE LIMITING
# ============================================
# Redis connection string for rate limiting
REDIS_URL=redis://localhost:6379/0
# Maximum number of chat requests per user within the time window
CHAT_RATE_LIMIT_REQUESTS=10
# Time window in seconds for rate limiting
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# GOOGLE AUTHENTICATION
# ============================================
# Google OAuth client ID (must match frontend)
GOOGLE_CLIENT_ID=replace-with-your-google-web-client-id
# Name of the authentication cookie
AUTH_COOKIE_NAME=assistant_session
# Session duration in days
AUTH_SESSION_DAYS=30
# Set to true in production (requires HTTPS)
AUTH_COOKIE_SECURE=false
# Cookie same-site policy (lax for local dev, strict for production)
AUTH_COOKIE_SAMESITE=lax

# ============================================
# LANGUAGE MODEL CONFIGURATION
# ============================================
# Choose backend: "huggingface" for hosted models or "vllm" for local/remote
LLM_BACKEND=huggingface

# Hugging Face configuration (used when LLM_BACKEND=huggingface)
HF_TOKEN=replace-with-your-hugging-face-token
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=openai/gpt-oss-20b:groq
HF_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731:deepinfra

# vLLM configuration (used when LLM_BACKEND=vllm)
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=local-only
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ngrok token (only needed for Colab vLLM setup)
NGROK_AUTHTOKEN=replace-with-your-ngrok-authtoken

# Generation parameters
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_ITERATIONS=15

# ============================================
# EXTERNAL API TOOLS (OPTIONAL)
# ============================================
# Monid API for additional information tools
MONID_API_KEY=replace-with-your-monid-api-key
MONID_BASE_URL=https://api.monid.ai
MONID_TIMEOUT_SECONDS=30

# ============================================
# EMBEDDING MODEL CONFIGURATION
# ============================================
# Local embedding model for document vectors
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Device for embeddings: cpu or cuda
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384

# ============================================
# QDRANT VECTOR DATABASE
# ============================================
# Qdrant Cloud configuration
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-with-your-qdrant-api-key
QDRANT_COLLECTION=assistant_documents
# Models configured in Qdrant Cloud for hybrid search
QDRANT_DENSE_MODEL=sentence-transformers/all-minilm-l6-v2
QDRANT_SPARSE_MODEL=qdrant/bm25
QDRANT_RERANKER_MODEL=answerdotai/answerai-colbert-small-v1
QDRANT_RERANKER_DIMENSION=96

# ============================================
# RAG RETRIEVAL SETTINGS
# ============================================
# Document chunking parameters
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# Number of chunks to retrieve
RAG_RETRIEVAL_TOP_K=5
# Number of candidates for reranking
RAG_CANDIDATE_TOP_K=20
# Minimum similarity score for retrieval
RAG_SCORE_THRESHOLD=0.25

# ============================================
# DOCUMENT INGESTION
# ============================================
# Directory for example documents
DOCUMENTS_DIRECTORY=data/documents
# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=10
# Maximum number of files in batch upload
MAX_BATCH_UPLOAD_FILES=10
# How long to keep documents before automatic cleanup
DOCUMENT_RETENTION_DAYS=10
# How often to run cleanup (set to 0 to disable)
DOCUMENT_CLEANUP_INTERVAL_SECONDS=3600
# Number of documents to delete per cleanup batch
DOCUMENT_CLEANUP_BATCH_SIZE=100
