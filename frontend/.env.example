# ============================================
# FRONTEND CONFIGURATION
# ============================================

# Backend API URL (where the FastAPI server is running)
# This is used by the Next.js rewrite to proxy requests
BACKEND_URL=http://localhost:8000

# Google OAuth Client ID
# This must be public because Google requires the browser to initialize the sign-in button
# Must match the GOOGLE_CLIENT_ID in the backend .env file
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-your-google-web-client-id

# API path prefix
# This path is rewritten by Next.js to proxy to the backend
# Keeping it same-origin ensures authentication cookies work correctly
NEXT_PUBLIC_API_URL=/backend/api/v1
